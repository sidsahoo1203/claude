{
  "name": "hourglass",
  "private": true,
  "description": "Personal time logging & reflection app (monorepo: server/ + client/)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "db": "npm --prefix server run db",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node -e \"process.env.NODE_ENV='production';require('./server/src/index.js')\"",
    "test": "npm --prefix server test",
    "set-password": "npm --prefix server run set-password",
    "backup": "npm --prefix server run backup"
  }
}
