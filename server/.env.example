# Copy to server/.env and run `npm run set-password` to fill PASSWORD_HASH and JWT_SECRET.
PORT=4000
# Local dev:
MONGODB_URI=mongodb://localhost:27017/timelog
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/timelog?retryWrites=true&w=majority
APP_TZ=Asia/Kolkata
LOG_WINDOW_HOURS=12
# Comma-separated, e.g. http://localhost:5173,https://sidsahoo1203.github.io
CLIENT_ORIGIN=http://localhost:5173
# Set true when served over HTTPS (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
# 'strict' when client and API share a site; 'none' when the client is on GitHub Pages (forces Secure)
COOKIE_SAMESITE=strict
PASSWORD_HASH=
JWT_SECRET=
